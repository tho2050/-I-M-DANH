@model IEnumerable<GpsAttendance.Models.ActivityListItemViewModel>

@{
    ViewData["Title"] = "Danh Sách Hoạt Động Điểm Danh";
}

@section Styles {
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
    /* ===== HERO SECTION ===== */
    .hero-section {
        position: relative;
        padding: 3rem 0 2.5rem;
        overflow: hidden;
    }
    .hero-section::before {
        content: '';
        position: absolute;
        top: -120px; right: -80px;
        width: 400px; height: 400px;
        background: radial-gradient(circle, rgba(99,102,241,0.15) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .hero-section::after {
        content: '';
        position: absolute;
        bottom: -80px; left: -60px;
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(168,85,247,0.1) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }
    .hero-title {
        font-size: 2.2rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        background: linear-gradient(135deg, #e2e8f0 0%, #a5b4fc 50%, #c084fc 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        line-height: 1.2;
    }
    .hero-subtitle {
        color: #94a3b8;
        font-size: 1rem;
        max-width: 560px;
        line-height: 1.6;
    }
    .hero-stats {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        margin-top: 1.5rem;
    }
    .stat-card {
        background: rgba(30, 30, 56, 0.7);
        border: 1px solid rgba(99, 102, 241, 0.15);
        border-radius: 14px;
        padding: 1rem 1.4rem;
        backdrop-filter: blur(10px);
        min-width: 130px;
    }
    .stat-card .stat-number {
        font-size: 1.6rem;
        font-weight: 800;
        background: linear-gradient(135deg, #818cf8, #c084fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .stat-card .stat-label {
        font-size: 0.78rem;
        color: #64748b;
        margin-top: 2px;
    }

    /* ===== ACTION BUTTONS ===== */
    .btn-hero-primary {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 12px 28px;
        border-radius: 12px;
        transition: all 0.3s;
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.35);
    }
    .btn-hero-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(99, 102, 241, 0.5);
        color: #fff;
    }
    .btn-hero-outline {
        background: transparent;
        color: #a5b4fc;
        border: 1px solid rgba(99, 102, 241, 0.35);
        font-weight: 600;
        font-size: 0.95rem;
        padding: 12px 24px;
        border-radius: 12px;
        transition: all 0.3s;
    }
    .btn-hero-outline:hover {
        background: rgba(99, 102, 241, 0.1);
        border-color: rgba(99, 102, 241, 0.6);
        color: #c4b5fd;
    }

    /* ===== SEARCH & FILTER BAR ===== */
    .toolbar-section {
        margin-bottom: 2rem;
    }
    .search-box {
        position: relative;
    }
    .search-box input {
        background: rgba(30, 30, 56, 0.6);
        border: 1px solid rgba(99, 102, 241, 0.15);
        border-radius: 12px;
        padding: 12px 16px 12px 44px;
        color: #e2e8f0;
        font-size: 0.92rem;
        width: 100%;
        transition: all 0.3s;
    }
    .search-box input::placeholder { color: #64748b; }
    .search-box input:focus {
        outline: none;
        border-color: rgba(99, 102, 241, 0.5);
        background: rgba(30, 30, 56, 0.8);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .search-box .search-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #64748b;
        font-size: 0.9rem;
    }

    .filter-pills {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .filter-pill {
        background: rgba(30, 30, 56, 0.6);
        border: 1px solid rgba(99, 102, 241, 0.12);
        color: #94a3b8;
        font-weight: 500;
        font-size: 0.82rem;
        padding: 8px 16px;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s;
    }
    .filter-pill:hover {
        background: rgba(99, 102, 241, 0.1);
        color: #c4b5fd;
    }
    .filter-pill.active {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        border-color: transparent;
        color: #fff;
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.3);
    }

    /* ===== ACTIVITY CARDS ===== */
    .activity-card {
        background: rgba(22, 22, 42, 0.7);
        border: 1px solid rgba(99, 102, 241, 0.1);
        border-radius: 18px;
        padding: 0;
        overflow: hidden;
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        backdrop-filter: blur(10px);
    }
    .activity-card:hover {
        transform: translateY(-6px);
        border-color: rgba(99, 102, 241, 0.35);
        box-shadow: 0 20px 40px rgba(99, 102, 241, 0.12), 0 0 0 1px rgba(99, 102, 241, 0.15);
    }
    .card-header-strip {
        height: 4px;
        background: linear-gradient(90deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
    }
    .card-header-strip.ended {
        background: linear-gradient(90deg, #374151, #4b5563);
    }
    .card-body-content {
        padding: 1.4rem 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* Code badge */
    .code-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-weight: 700;
        font-size: 0.78rem;
        color: #a5b4fc;
        background: rgba(99, 102, 241, 0.1);
        border: 1px dashed rgba(99, 102, 241, 0.3);
        padding: 4px 12px;
        border-radius: 8px;
        letter-spacing: 0.5px;
    }

    /* Status badges */
    .status-live {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.76rem;
        font-weight: 600;
        color: #34d399;
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 4px 12px;
        border-radius: 20px;
    }
    .status-upcoming {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.76rem;
        font-weight: 600;
        color: #fbbf24;
        background: rgba(251, 191, 36, 0.1);
        border: 1px solid rgba(251, 191, 36, 0.2);
        padding: 4px 12px;
        border-radius: 20px;
    }
    .status-ended {
        display: inline-flex;
        align-items: center;
        font-size: 0.76rem;
        font-weight: 600;
        color: #64748b;
        background: rgba(100, 116, 139, 0.1);
        border: 1px solid rgba(100, 116, 139, 0.2);
        padding: 4px 12px;
        border-radius: 20px;
    }
    .pulse-dot {
        width: 7px; height: 7px;
        background: #34d399;
        border-radius: 50%;
        animation: livePulse 1.5s ease-in-out infinite;
    }
    @@keyframes livePulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.6); }
        50% { opacity: 0.7; box-shadow: 0 0 0 8px rgba(52, 211, 153, 0); }
    }

    .card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #f1f5f9;
        margin: 0.8rem 0 0.3rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.35;
    }
    .card-desc {
        font-size: 0.82rem;
        color: #64748b;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
        margin-bottom: 1rem;
    }

    /* Info rows */
    .info-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 0.84rem;
        color: #94a3b8;
        margin-bottom: 0.6rem;
    }
    .info-row i {
        color: #6366f1;
        width: 16px;
        text-align: center;
        margin-top: 2px;
        flex-shrink: 0;
    }
    .info-row .radius-tag {
        display: inline-block;
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        font-weight: 600;
        font-size: 0.78rem;
        padding: 2px 8px;
        border-radius: 6px;
    }
    .info-row .count-tag {
        color: #34d399;
        font-weight: 700;
    }
    .distance-row {
        color: #c084fc;
    }
    .distance-row i { color: #c084fc; }

    .card-divider {
        border: none;
        border-top: 1px solid rgba(99, 102, 241, 0.08);
        margin: 0.5rem 0;
    }

    /* Action buttons row */
    .card-actions {
        display: flex;
        gap: 8px;
        margin-top: auto;
        padding-top: 0.5rem;
    }
    .btn-checkin-card {
        flex: 1;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        border: none;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 10px 16px;
        border-radius: 10px;
        text-align: center;
        text-decoration: none;
        transition: all 0.25s;
    }
    .btn-checkin-card:hover {
        transform: scale(1.02);
        box-shadow: 0 4px 18px rgba(99, 102, 241, 0.35);
        color: #fff;
    }
    .btn-icon-card {
        background: rgba(30, 30, 56, 0.8);
        border: 1px solid rgba(99, 102, 241, 0.15);
        color: #94a3b8;
        width: 40px; height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }
    .btn-icon-card:hover {
        background: rgba(99, 102, 241, 0.15);
        color: #a5b4fc;
        border-color: rgba(99, 102, 241, 0.3);
    }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(22, 22, 42, 0.5);
        border-radius: 20px;
        border: 1px dashed rgba(99, 102, 241, 0.15);
    }
    .empty-state i {
        font-size: 4rem;
        color: #334155;
        margin-bottom: 1rem;
    }
    .empty-state h4 {
        color: #94a3b8;
        font-weight: 600;
    }
    .empty-state p {
        color: #64748b;
        font-size: 0.9rem;
    }

    /* ===== MODAL STYLES ===== */
    .modal-content.dark-modal {
        background: #1a1a2e;
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 20px;
        color: #e2e8f0;
    }
    .modal-content.dark-modal .modal-header {
        border-bottom: 1px solid rgba(99, 102, 241, 0.1);
        padding: 1.2rem 1.5rem;
    }
    .modal-content.dark-modal .modal-body {
        padding: 1.5rem;
    }
    .modal-content.dark-modal .modal-footer {
        border-top: 1px solid rgba(99, 102, 241, 0.1);
    }
    .modal-content.dark-modal .btn-close {
        filter: invert(1) grayscale(100%) brightness(200%);
    }

    #mapContainer {
        height: 380px;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid rgba(99, 102, 241, 0.15);
    }

    .qr-wrapper {
        background: #fff;
        padding: 16px;
        border-radius: 14px;
        display: inline-block;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .gps-status-text {
        font-size: 0.82rem;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 768px) {
        .hero-title { font-size: 1.6rem; }
        .hero-stats { gap: 0.8rem; }
        .stat-card { min-width: 100px; padding: 0.8rem 1rem; }
        .stat-card .stat-number { font-size: 1.3rem; }
    }
</style>
}

<div class="container">

    <!-- ===== HERO SECTION ===== -->
    <section class="hero-section">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span style="font-size: 0.78rem; color: #818cf8; background: rgba(99,102,241,0.1); padding: 5px 12px; border-radius: 8px; font-weight: 500;">
                        <i class="fa-solid fa-satellite-dish me-1"></i> Xác thực GPS vệ tinh
                    </span>
                    <span style="font-size: 0.78rem; color: #c084fc; background: rgba(168,85,247,0.1); padding: 5px 12px; border-radius: 8px; font-weight: 500;">
                        <i class="fa-solid fa-bolt me-1"></i> Real-time
                    </span>
                </div>

                <h1 class="hero-title mb-3">
                    Hệ Thống Điểm Danh<br/>Hoạt Động & Sự Kiện
                </h1>
                <p class="hero-subtitle mb-4">
                    Chọn hoạt động bạn đang tham gia hoặc quét mã QR tại hội trường 
                    để xác thực vị trí GPS và hoàn tất điểm danh tức thì.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-action="Scan" class="btn btn-hero-primary">
                        <i class="fa-solid fa-qrcode me-2"></i> Quét Mã QR
                    </a>
                    <button class="btn btn-hero-outline" onclick="requestUserLocation()" id="gpsBtn">
                        <i class="fa-solid fa-location-crosshairs me-2"></i>
                        <span id="gpsStatusText" class="gps-status-text">Bật GPS kiểm tra vị trí</span>
                    </button>
                </div>

                <div class="hero-stats">
                    <div class="stat-card">
                        <div class="stat-number">@(Model?.Count() ?? 0)</div>
                        <div class="stat-label">Hoạt động đang mở</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number">@(Model?.Sum(m => m.AttendancesCount) ?? 0)</div>
                        <div class="stat-label">Lượt điểm danh</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><i class="fa-solid fa-shield-check" style="font-size:1.3rem;"></i></div>
                        <div class="stat-label">Xác thực GPS</div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5 d-none d-lg-flex justify-content-center align-items-center" style="position: relative;">
                <div style="position: relative;">
                    <i class="fa-solid fa-earth-americas" style="font-size: 10rem; color: rgba(99,102,241,0.08);"></i>
                    <i class="fa-solid fa-location-dot" style="position: absolute; top: 25%; left: 55%; font-size: 2.5rem; color: rgba(99,102,241,0.35); animation: floatPin 3s ease-in-out infinite;"></i>
                    <i class="fa-solid fa-location-dot" style="position: absolute; top: 50%; left: 30%; font-size: 1.5rem; color: rgba(168,85,247,0.3); animation: floatPin 3s ease-in-out infinite 0.5s;"></i>
                    <i class="fa-solid fa-location-dot" style="position: absolute; top: 60%; left: 70%; font-size: 1.8rem; color: rgba(236,72,153,0.25); animation: floatPin 3s ease-in-out infinite 1s;"></i>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== TOOLBAR: SEARCH & FILTER ===== -->
    <section class="toolbar-section">
        <div class="row g-3 align-items-center">
            <div class="col-md-5">
                <div class="search-box">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="searchInput" placeholder="Tìm kiếm hoạt động, mã code, địa điểm..." oninput="filterActivities()" />
                </div>
            </div>
            <div class="col-md-7 d-flex justify-content-md-end">
                <div class="filter-pills">
                    <button class="filter-pill active" onclick="setFilter('all', this)">
                        <i class="fa-solid fa-layer-group me-1"></i> Tất cả <span class="ms-1 opacity-75">(@(Model?.Count() ?? 0))</span>
                    </button>
                    <button class="filter-pill" onclick="setFilter('ongoing', this)">
                        <i class="fa-solid fa-circle-play me-1"></i> Đang diễn ra
                    </button>
                    <button class="filter-pill" onclick="setFilter('upcoming', this)">
                        <i class="fa-regular fa-clock me-1"></i> Sắp tới
                    </button>
                    <button class="filter-pill" onclick="setFilter('ended', this)">
                        <i class="fa-solid fa-flag-checkered me-1"></i> Đã kết thúc
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== ACTIVITIES GRID ===== -->
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="fa-regular fa-calendar-xmark"></i>
            <h4 class="mt-2">Chưa có hoạt động nào đang mở</h4>
            <p>Vui lòng quay lại sau hoặc liên hệ ban tổ chức để được hỗ trợ.</p>
        </div>
    }
    else
    {
        <div class="row g-4" id="activitiesGrid">
            @{
                var now = DateTime.Now;
            }
            @foreach (var item in Model)
            {
                var isLive = (!item.StartTime.HasValue || item.StartTime <= now) && (!item.EndTime.HasValue || item.EndTime >= now);
                var isUpcoming = item.StartTime.HasValue && item.StartTime > now;
                var isEnded = item.EndTime.HasValue && item.EndTime < now;
                var category = isLive ? "ongoing" : (isUpcoming ? "upcoming" : "ended");

                <div class="col-md-6 col-lg-4 activity-item"
                     data-title="@item.Title.ToLower()"
                     data-code="@item.ActivityCode.ToLower()"
                     data-location="@item.LocationAddress.ToLower()"
                     data-category="@category"
                     data-lat="@item.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                     data-lng="@item.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                    <div class="activity-card">
                        <!-- Color strip top -->
                        <div class="card-header-strip @(isEnded ? "ended" : "")"></div>

                        <div class="card-body-content">
                            <!-- Badges row -->
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="code-badge">
                                    <i class="fa-solid fa-hashtag"></i> @item.ActivityCode
                                </span>
                                @if (isLive)
                                {
                                    <span class="status-live"><span class="pulse-dot"></span> Đang diễn ra</span>
                                }
                                else if (isUpcoming)
                                {
                                    <span class="status-upcoming"><i class="fa-regular fa-clock"></i> Sắp tới</span>
                                }
                                else
                                {
                                    <span class="status-ended">Đã kết thúc</span>
                                }
                            </div>

                            <!-- Title & Description -->
                            <h5 class="card-title" title="@item.Title">@item.Title</h5>
                            <p class="card-desc">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "Không có mô tả bổ sung." : item.Description)
                            </p>

                            <hr class="card-divider" />

                            <!-- Info rows -->
                            <div class="my-2 flex-grow-1">
                                <div class="info-row">
                                    <i class="fa-solid fa-location-dot"></i>
                                    <span class="text-truncate" title="@item.LocationAddress">@item.LocationAddress</span>
                                </div>
                                <div class="info-row">
                                    <i class="fa-solid fa-bullseye"></i>
                                    <span>Bán kính: <span class="radius-tag">@item.RadiusMeters m</span></span>
                                </div>
                                <div class="info-row">
                                    <i class="fa-regular fa-calendar"></i>
                                    <span>@(item.StartTime?.ToString("HH:mm dd/MM") ?? "Mở") → @(item.EndTime?.ToString("HH:mm dd/MM") ?? "Không giới hạn")</span>
                                </div>
                                <div class="info-row">
                                    <i class="fa-solid fa-user-check"></i>
                                    <span>Đã điểm danh: <span class="count-tag">@item.AttendancesCount</span> lượt hợp lệ</span>
                                </div>

                                <!-- GPS distance (hidden until user enables GPS) -->
                                <div class="info-row distance-row d-none user-distance-box">
                                    <i class="fa-solid fa-route"></i>
                                    <span>Cách bạn: <strong class="distance-value">--</strong></span>
                                </div>
                            </div>

                            <!-- Actions -->
                            <div class="card-actions">
                                <a href="@Url.Action("CheckIn", "Activity", new { code = item.ActivityCode })" class="btn-checkin-card">
                                    <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Điểm danh
                                </a>
                                <button type="button" class="btn-icon-card" title="Mã QR"
                                        onclick="showQrModal('@item.ActivityCode', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Title)')">
                                    <i class="fa-solid fa-qrcode"></i>
                                </button>
                                <button type="button" class="btn-icon-card" title="Xem bản đồ"
                                        onclick="showMapModal('@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Title)', @item.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture), @item.RadiusMeters, '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.LocationAddress)')">
                                    <i class="fa-solid fa-map-location-dot"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- ===== QR CODE MODAL ===== -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="qrModalTitle">Mã QR Điểm Danh</h5>
                    <p class="text-muted small mb-0 mt-1">Quét mã bằng Camera, Zalo hoặc Momo</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <div class="qr-wrapper mx-auto mb-3">
                    <div id="qrcode"></div>
                </div>
                <div class="code-badge fs-6 py-2 px-3 mx-auto" style="width: fit-content;" id="qrModalCode">---</div>
                <p class="mt-3 small text-muted">
                    <i class="fa-solid fa-info-circle me-1"></i> Sinh viên cần đứng trong bán kính quy định để điểm danh thành công.
                </p>
            </div>
            <div class="modal-footer justify-content-center border-0">
                <a href="#" id="qrDirectLink" class="btn btn-hero-primary px-4">
                    Mở trang điểm danh <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- ===== MAP MODAL ===== -->
<div class="modal fade" id="mapModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content dark-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title fw-bold" id="mapModalTitle">Vị trí điểm danh</h5>
                    <p class="small mb-0 mt-1" style="color: #64748b;" id="mapModalAddress">---</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="mapContainer"></div>
                <p class="mt-3 mb-0 small" style="color: #64748b;">
                    <i class="fa-solid fa-circle text-primary me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>
                    Vòng tròn thể hiện vùng bán kính điểm danh hợp lệ.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Float pin animation -->
<style>
    @@keyframes floatPin {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }
</style>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
    // ===== STATE =====
    let userCoords = null;
    let leafletMap = null;
    let mapMarker = null;
    let mapCircle = null;

    // ===== 1. SEARCH =====
    function filterActivities() {
        const q = document.getElementById('searchInput').value.toLowerCase().trim();
        document.querySelectorAll('.activity-item').forEach(item => {
            const t = item.dataset.title || '';
            const c = item.dataset.code || '';
            const l = item.dataset.location || '';
            item.style.display = (t.includes(q) || c.includes(q) || l.includes(q)) ? '' : 'none';
        });
    }

    // ===== 2. FILTER =====
    function setFilter(category, btn) {
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('.activity-item').forEach(item => {
            item.style.display = (category === 'all' || item.dataset.category === category) ? '' : 'none';
        });
    }

    // ===== 3. QR MODAL =====
    function showQrModal(code, title) {
        document.getElementById('qrModalTitle').textContent = title;
        document.getElementById('qrModalCode').textContent = 'MÃ: ' + code;
        const url = window.location.origin + '/Activity/CheckIn/' + encodeURIComponent(code);
        document.getElementById('qrDirectLink').href = url;

        const container = document.getElementById('qrcode');
        container.innerHTML = '';
        new QRCode(container, {
            text: url,
            width: 220,
            height: 220,
            colorDark: '#1e1b4b',
            colorLight: '#ffffff',
            correctLevel: QRCode.CorrectLevel.H
        });

        new bootstrap.Modal(document.getElementById('qrModal')).show();
    }

    // ===== 4. MAP MODAL =====
    function showMapModal(title, lat, lng, radius, address) {
        document.getElementById('mapModalTitle').textContent = title;
        document.getElementById('mapModalAddress').innerHTML =
            '<i class="fa-solid fa-location-dot text-danger me-1"></i> ' + address + ' (Bán kính: <b>' + radius + 'm</b>)';

        const modalEl = document.getElementById('mapModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();

        modalEl.addEventListener('shown.bs.modal', function handler() {
            modalEl.removeEventListener('shown.bs.modal', handler);
            if (!leafletMap) {
                leafletMap = L.map('mapContainer').setView([lat, lng], 16);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '&copy; OpenStreetMap'
                }).addTo(leafletMap);
            } else {
                leafletMap.setView([lat, lng], 16);
                leafletMap.invalidateSize();
            }
            if (mapMarker) leafletMap.removeLayer(mapMarker);
            if (mapCircle) leafletMap.removeLayer(mapCircle);

            mapMarker = L.marker([lat, lng]).addTo(leafletMap)
                .bindPopup('<b>' + title + '</b><br>' + address).openPopup();
            mapCircle = L.circle([lat, lng], {
                color: '#6366f1', fillColor: '#818cf8', fillOpacity: 0.2, radius: radius
            }).addTo(leafletMap);
        });
    }

    // ===== 5. GPS LOCATION =====
    function haversine(lat1, lon1, lat2, lon2) {
        const R = 6371e3;
        const toRad = v => v * Math.PI / 180;
        const dLat = toRad(lat2 - lat1), dLon = toRad(lon2 - lon1);
        const a = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    }

    function requestUserLocation() {
        if (!navigator.geolocation) {
            alert('Trình duyệt không hỗ trợ GPS.');
            return;
        }
        const statusEl = document.getElementById('gpsStatusText');
        statusEl.textContent = 'Đang lấy tọa độ...';

        navigator.geolocation.getCurrentPosition(
            pos => {
                userCoords = { lat: pos.coords.latitude, lng: pos.coords.longitude };
                statusEl.textContent = 'GPS OK (±' + Math.round(pos.coords.accuracy) + 'm)';
                document.getElementById('gpsBtn').style.borderColor = 'rgba(52,211,153,0.5)';
                document.getElementById('gpsBtn').style.color = '#34d399';

                // Update distances on all cards
                document.querySelectorAll('.activity-item').forEach(item => {
                    const lat = parseFloat(item.dataset.lat);
                    const lng = parseFloat(item.dataset.lng);
                    if (isNaN(lat) || isNaN(lng)) return;

                    const dist = haversine(userCoords.lat, userCoords.lng, lat, lng);
                    const box = item.querySelector('.user-distance-box');
                    const val = item.querySelector('.distance-value');
                    if (box && val) {
                        box.classList.remove('d-none');
                        val.textContent = dist < 1000 ? Math.round(dist) + ' m' : (dist / 1000).toFixed(1) + ' km';
                    }
                });
            },
            err => {
                statusEl.textContent = 'Lỗi GPS - cấp quyền';
                alert('Vui lòng cấp quyền truy cập vị trí trên trình duyệt.');
            },
            { enableHighAccuracy: true, timeout: 10000 }
        );
    }
</script>
}
