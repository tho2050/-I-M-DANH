@{
    ViewData["Title"] = "Không tìm thấy";
}

<div class="container" style="max-width: 500px; margin: 4rem auto; text-align: center;">
    <i class="fa-solid fa-triangle-exclamation" style="font-size: 4rem; color: rgba(251,191,36,0.4); margin-bottom: 1.5rem;"></i>
    <h3 style="font-weight: 700; color: #f1f5f9; margin-bottom: 0.5rem;">Không tìm thấy</h3>
    <p style="color: #94a3b8; font-size: 0.95rem; line-height: 1.6;">
        @(ViewBag.ErrorMessage ?? "Hoạt động không tồn tại hoặc đã bị khóa.")
    </p>
    <a asp-controller="Activity" asp-action="Index"
       style="display: inline-block; margin-top: 1.5rem; background: linear-gradient(135deg, #6366f1, #8b5cf6); color: #fff; padding: 12px 28px; border-radius: 12px; font-weight: 600; text-decoration: none; transition: all 0.2s;">
        <i class="fa-solid fa-arrow-left me-2"></i> Quay về trang chủ
    </a>
</div>
