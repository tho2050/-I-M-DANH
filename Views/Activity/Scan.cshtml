@{
    ViewData["Title"] = "Quét Mã QR";
}

@section Styles {
<style>
    .scan-page {
        max-width: 500px;
        margin: 3rem auto;
        text-align: center;
    }
    .scan-icon {
        font-size: 5rem;
        color: rgba(99, 102, 241, 0.3);
        margin-bottom: 1.5rem;
    }
    .scan-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #e2e8f0;
    }
    .scan-desc {
        color: #94a3b8;
        margin: 1rem 0 2rem;
        line-height: 1.6;
    }
    .code-input-group {
        display: flex;
        gap: 10px;
        max-width: 400px;
        margin: 0 auto;
    }
    .code-input-group input {
        flex: 1;
        background: rgba(30, 30, 56, 0.6);
        border: 1px solid rgba(99, 102, 241, 0.2);
        border-radius: 12px;
        padding: 12px 16px;
        color: #e2e8f0;
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }
    .code-input-group input::placeholder {
        color: #475569;
        text-transform: none;
        letter-spacing: 0;
        font-weight: 400;
    }
    .code-input-group input:focus {
        outline: none;
        border-color: rgba(99, 102, 241, 0.5);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .btn-go {
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        border: none;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 12px;
        transition: all 0.2s;
    }
    .btn-go:hover {
        box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4);
        color: #fff;
    }
</style>
}

<div class="container">
    <div class="scan-page">
        <div class="scan-icon">
            <i class="fa-solid fa-qrcode"></i>
        </div>
        <h2 class="scan-title">Nhập Mã Hoạt Động</h2>
        <p class="scan-desc">
            Nhập mã code hoạt động (ví dụ: <strong style="color:#a5b4fc;">SVTN2026</strong>) 
            hoặc quét mã QR tại hội trường để truy cập trang điểm danh nhanh.
        </p>

        <form id="codeForm" onsubmit="goToCheckIn(event)">
            <div class="code-input-group">
                <input type="text" id="activityCodeInput" placeholder="Nhập mã hoạt động..." required autofocus />
                <button type="submit" class="btn-go">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        </form>

        <p class="mt-4" style="color: #475569; font-size: 0.85rem;">
            <i class="fa-solid fa-circle-info me-1"></i>
            Hoặc quay lại <a asp-controller="Activity" asp-action="Index" style="color: #818cf8;">danh sách hoạt động</a>
        </p>
    </div>
</div>

@section Scripts {
<script>
    function goToCheckIn(e) {
        e.preventDefault();
        const code = document.getElementById('activityCodeInput').value.trim();
        if (code) {
            window.location.href = '/Activity/CheckIn/' + encodeURIComponent(code);
        }
    }
</script>
}
